# token: one server-side PAT shared by every MCP caller
# oauth: each ChatGPT connection authenticates through Gitea OAuth
AUTH_MODE=oauth

GITEA_BASE_URL=https://git.example.com

# OAuth mode
PUBLIC_BASE_URL=https://gitea-mcp.example.com
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
GITEA_OAUTH_SCOPES=read:user write:repository

# Generate with: openssl rand -base64 32
# Keep this stable. Rotating it invalidates existing ChatGPT OAuth connections.
OAUTH_ENCRYPTION_KEY=

# Token mode only
# GITEA_TOKEN=

LISTEN_ADDR=:8080
MCP_PATH=/mcp
REQUEST_TIMEOUT=30s
