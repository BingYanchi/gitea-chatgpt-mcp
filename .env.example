# Recommended private deployment: service-account PAT + Secure MCP Tunnel.
AUTH_MODE=token
GITEA_BASE_URL=https://git.example.com
GITEA_TOKEN=

# OpenAI Secure MCP Tunnel runtime credentials.
# Create the tunnel in OpenAI Platform, then provide its tunnel ID and a control-plane API key.
TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Optional image pinning. Keep latest for automatic stable updates, or pin a sha-* tag.
MCP_IMAGE_TAG=latest
TUNNEL_IMAGE_TAG=latest

REQUEST_TIMEOUT=30s
MCP_STARTUP_WAIT_TIMEOUT=60s
TUNNEL_LOG_LEVEL=info
TUNNEL_LOG_FORMAT=json

# Optional OAuth/direct-public mode. Not required for tunnel + token deployments.
# AUTH_MODE=oauth
# PUBLIC_BASE_URL=https://gitea-mcp.example.com
# GITEA_OAUTH_CLIENT_ID=
# GITEA_OAUTH_CLIENT_SECRET=
# GITEA_OAUTH_SCOPES=read:user write:repository
# OAUTH_ENCRYPTION_KEY=
